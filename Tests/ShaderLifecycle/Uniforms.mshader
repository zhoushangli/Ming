shader_type spatial;

group_uniforms Shape;
uniform float height : hint_range(-2, 2);
uniform float2 offset = float2(0.0, 0.0);
uniform float3 rgb = float3(0.0, 1.0, 0.0);
group_uniforms Appearance;
uniform float4 multiplier : hint_color = float4(1.0, 1.0, 1.0, 1.0);

uniform int mode : hint_enum("Normal", "Tinted") = 1;
group_uniforms;

void vertex(inout VertexContext v)
{
    if (mode == -8)
    {
        float4 expected = float4(-0.25, 1.5, 0.12345, 0.87654);
        bool valid = all(abs(v.color - expected) < 0.000001) && all(abs(multiplier - expected) < 0.000001);
        v.color = valid ? float4(0, 0, 1, 1) : float4(1, 0, 0, 1);
    }
    v.modelPosition.xy += offset;
    v.modelPosition.y += height;
}

void fragment(inout FragmentContext f)
{
    if (mode == -8)
    {
        bool valid = all(abs(multiplier - float4(-0.25, 1.5, 0.12345, 0.87654)) < 0.000001) && f.vertexColor.b > 0.9;
        f.color = valid ? float4(0, 0, 1, 1) : float4(1, 0, 0, 1);
        return;
    }
    f.color = mode == 1 || mode == -7 ? float4(rgb, 1.0) * multiplier : float4(1, 0, 1, 1);
}
