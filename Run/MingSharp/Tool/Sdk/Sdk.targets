<Project>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <MingApiDirectory Condition="'$(MingApiDirectory)' == ''">$(MSBuildThisFileDirectory)../../Api/</MingApiDirectory>
    <AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths>
  </PropertyGroup>

  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)../Analyzers/Ming.SourceGenerators.dll" />
    <CompilerVisibleProperty Include="MingProjectDirectory" />
    <Reference Include="MingSharp">
      <HintPath>$(MingApiDirectory)/MingSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <MingProjectDirectory>$(MSBuildProjectDirectory)</MingProjectDirectory>
    <WarningsAsErrors>$(WarningsAsErrors);CS8784;CS8785</WarningsAsErrors>
  </PropertyGroup>

  <Target Name="ValidateMingApi" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(MingApiDirectory)/MingSharp.dll')"
      Text="MingSharp.dll was not found in '$(MingApiDirectory)'." />
  </Target>
</Project>
