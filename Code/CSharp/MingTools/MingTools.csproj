<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Ming.NET.Sdk/MingSdkPackage.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="MingSdkPackageId" Value="$(MingSdkPackageId)" />
