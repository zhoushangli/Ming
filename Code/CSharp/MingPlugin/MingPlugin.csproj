<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../MingSdkPackage.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="DeployManagedRuntime" AfterTargets="Build">
    <Exec Command="xcopy /Y /F /I /E &quot;$(TargetDir)*&quot; &quot;$(MSBuildProjectDirectory)\..\..\..\Run\MingSharp\Api\&quot;" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MingSharp\MingSharp.csproj" />
    <AssemblyMetadata Include="MingSdkPackageId" Value="$(MingSdkPackageId)" />
    <AssemblyMetadata Include="MingSdkPackageVersion" Value="$(MingSdkPackageVersion)" />
  </ItemGroup>

</Project>
